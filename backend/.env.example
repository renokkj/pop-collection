# Copie este arquivo para "backend/.env" e preencha. O .env NUNCA vai para o GitHub.
# Os valores ficam no Supabase → botão "Connect" (topo do painel) → aba "Connection String" → "Session pooler".

# Endereço do banco, no formato jdbc (troque HOST pelo host do Session pooler, ex.: aws-0-sa-east-1.pooler.supabase.com)
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
# Usuário: pop_api + ponto + id do projeto
DB_USER=pop_api.giimoieqyosmklpdhhfn
# A senha que você escolheu no arquivo supabase/api-usuario-pop_api.sql
DB_PASSWORD=

# Só se o seu projeto usar a chave antiga "JWT Secret" (Project Settings → JWT Keys → Legacy JWT Secret)
SUPABASE_JWT_SECRET=
